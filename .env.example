# DJANGO CONFIGURATION
DEBUG=True
SECRET_KEY=your-secret-key
ALLOWED_HOSTS=127.0.0.1,localhost

# PostgreSQL
DB_NAME=smartpresence_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=yourgmail@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=Smart Presence <yourgmail@gmail.com>

# AI Service
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_TIMEOUT=300
AI_SERVICE_VERIFY_TIMEOUT=600
AI_JOB_WORKERS=2
AI_JOB_STALE_AFTER=1200
AI_JOB_RETENTION_DAYS=7

# Cloudinary
CLOUDINARY_CLOUD_NAME=xxxxxx
CLOUDINARY_API_KEY=xxxxxx
CLOUDINARY_API_SECRET=xxxxxx

# Default superuser (created on server start)
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=change-me
SUPERUSER_NAME=Smart Presence Admin

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# CONSTANTS
DEFAULT_PAGE_SIZE = 20
MAX_PAGE_SIZE = 100
PASSWORD_LENGTH = 12
PHONE_LENGTH = 10
MAX_ATTENDANCE_IMAGES = 5
MAX_STUDENT_IMAGES = 1
MAX_FACE_REGISTER_IMAGES = 100
MAX_CAPTURE_SKEW_SECONDS = 120
MAX_NOTIFICATION_ATTACHMENTS = 10
MAX_NOTIFICATION_ATTACHMENT_MB = 50

FRONTEND_URL=http://localhost:5173

# Website contact form: enquiries are emailed here (sent from DEFAULT_FROM_EMAIL).
CONTACT_RECIPIENT_EMAIL=sinhaatharva@gmail.com

# Cloudflare Turnstile secret for the contact form's spam check. Leave empty to skip it.
# Cloudflare's test secret that always passes: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=

# HTTPS (defaults to on when DEBUG=False). Raise SECURE_HSTS_SECONDS to 31536000 once all is on HTTPS.
USE_HTTPS=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=3600

# Rate limiting (token bucket) and activity log retention.
RATE_LIMIT_ENABLED=True
ACTIVITY_LOG_RETENTION_DAYS=90

# Media: local files in development, Cloudinary when True (defaults to True when DEBUG=False).
USE_CLOUDINARY=False

# Shared secret sent to the AI service as X-AI-Service-Key (empty when the AI service has no key).
AI_SERVICE_API_KEY=

# Web Push keys: run "python manage.py generate_vapid_keys" and paste the two lines here.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Extra origins allowed to POST to Django's own forms (admin). Defaults to CORS_ALLOWED_ORIGINS.
CSRF_TRUSTED_ORIGINS=
